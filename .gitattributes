# normalize line endings, lf in the repository
* text=auto

# sources
*.cpp text diff=cpp
*.h text diff=cpp
*.hpp text diff=cpp
*.hlsl text
*.lua text
*.md text
*.txt text
*.json text diff=json
*.xml text diff=xml

# scripts keep their native line endings
*.bat text eol=crlf
*.sh text eol=lf

# binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.wav binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.lib binary
*.7z binary
