   <Entity name="sign_subtitle" id="209172230937856503" active="true" position="0 30.2 -20" rotation="0 0 0 1" scale="1 1 1">
    <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_text" material_path="project/terrain_example_resources/materials/sign_text.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
    <text_3d text="This island started as a flat square.&#10;Start between BRUSH TIPS and LAYER PAINT." font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="1.79999995" depth="0.159999996" weight="0" letter_spacing="0" line_spacing="1.20000005" resolution="128" alignment="1" />
   </Entity>
   <Entity name="sign_how_to" id="754347595994987764" active="true" position="26 0 -58" rotation="0 0.25038 0 0.968148" scale="1 1 1">
    <Entity name="heading" id="513426783629563981" active="true" position="0 19.6 0" rotation="0 0 0 1" scale="1 1 1">
     <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_heading" material_path="project/terrain_example_resources/materials/sign_heading.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
     <text_3d text="HOW TO SHAPE THE GROUND" font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="1.60000002" depth="0.129999995" weight="0" letter_spacing="0" line_spacing="1.20000005" resolution="128" alignment="1" />
    </Entity>
    <Entity name="body" id="1076209848064470512" active="true" position="-9.5 17.6 0" rotation="0 0 0 1" scale="1 1 1">
     <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_text" material_path="project/terrain_example_resources/materials/sign_text.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
     <text_3d text="1. Stop the game first, sculpting works in the editor&#10;2. Open the Terrain window: the Terrain button in&#10;    the top toolbar, or View > Widgets > Terrain&#10;3. Click Sculpt, near the top of that window&#10;4. Try Terrace on a hillside, then adjust Step height&#10;5. Point at the ground, a circle shows your brush&#10;6. Hold the LEFT mouse button and drag to paint&#10;7. Hold the RIGHT mouse button + W A S D to fly&#10;8. Try Ring for a rim or rotate Ridge for a crest&#10;9. Ctrl+Z undoes a stroke, Ctrl+S saves the world" font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="0.850000024" depth="0.0900000036" weight="0" letter_spacing="0" line_spacing="1.35000002" resolution="128" alignment="0" />
    </Entity>
    <Entity name="panel" id="11654791540081230384" active="true" position="0.5 12.8 0.4" rotation="0 0 0 1" scale="23.5 17.6 0.2">
     <render mesh_name="standard_cube" mesh_path="" sub_mesh_index="0" material_name="sign_panel" material_path="project/terrain_example_resources/materials/sign_panel.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
    </Entity>
   </Entity>
   <Entity name="sign_make_your_own" id="980407628313962404" active="true" position="-26 0 -58" rotation="0 -0.25038 0 0.968148" scale="1 1 1">
    <Entity name="heading" id="1385629317542769715" active="true" position="0 19.6 0" rotation="0 0 0 1" scale="1 1 1">
     <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_heading" material_path="project/terrain_example_resources/materials/sign_heading.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
     <text_3d text="PAINT THE TRAIL" font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="1.60000002" depth="0.129999995" weight="0" letter_spacing="0" line_spacing="1.20000005" resolution="128" alignment="1" />
    </Entity>
    <Entity name="body" id="1306919169550862322" active="true" position="-9.5 17.6 0" rotation="0 0 0 1" scale="1 1 1">
     <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_text" material_path="project/terrain_example_resources/materials/sign_text.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
     <text_3d text="1. Open Terrain and choose Ground&#10;2. Select dirt in Layers, then click Paint&#10;3. Set Radius to 4 m and follow the trail edge&#10;4. Drag left to extend it into the meadow&#10;5. Lower Opacity for a softer shoulder&#10;6. Turn on Erase to bring the meadow back&#10;&#10;The streaks of rock left of the trail use a stamp.&#10;Import striated_rock.png from data/brushes." font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="0.850000024" depth="0.0900000036" weight="0" letter_spacing="0" line_spacing="1.35000002" resolution="128" alignment="0" />
    </Entity>
    <Entity name="panel" id="11681081064777525250" active="true" position="0.5 12.8 0.4" rotation="0 0 0 1" scale="23.5 17.6 0.2">
     <render mesh_name="standard_cube" mesh_path="" sub_mesh_index="0" material_name="sign_panel" material_path="project/terrain_example_resources/materials/sign_panel.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
    </Entity>
   </Entity>
   <Entity name="sign_title_panel" id="11731513372032657763" active="true" position="0 32.1 -19.5" rotation="0 0 0 1" scale="76 11 0.2">
