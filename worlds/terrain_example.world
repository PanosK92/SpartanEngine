    <text_3d text="TERRAIN BRUSH WORKSHOP" font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="5" depth="0.400000006" weight="0" letter_spacing="0" line_spacing="1.20000005" resolution="128" alignment="1" />
