     <text_3d text="FLATTEN AND RESTORE" font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="1.1" depth="0.05" weight="0" letter_spacing="0" line_spacing="1.30" resolution="128" alignment="1" />
    </Entity>
    <Entity name="text" id="17490350000000000052" active="true" position="-5.75 4.1 0" rotation="0 0 0 1" scale="1 1 1">
     <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_text" material_path="project/terrain_example_resources/materials/sign_text.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
     <text_3d text="Ctrl-click ground to sample its height&#10;and switch to Flatten. Drag a shelf.&#10;Smooth softens the edge. Restore&#10;brushes back to the generated base.&#10;Use Ctrl+Z to bring the stroke back." font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="0.55" depth="0.05" weight="0" letter_spacing="0" line_spacing="1.30" resolution="128" alignment="0" />
    </Entity>
