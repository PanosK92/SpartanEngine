     <text_3d text="Ground &gt; Layers. Select dirt.&#10;Click Paint and set Radius to 4 m.&#10;Drag to extend the trail ahead.&#10;Lower Opacity for softer shoulders." font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="0.55" depth="0.05" weight="0" letter_spacing="0" line_spacing="1.30" resolution="128" alignment="0" />
