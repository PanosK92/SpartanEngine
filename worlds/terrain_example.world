   <Entity name="workshop_layer_erase" id="17490350000000000030" active="true" position="12 6 -109" rotation="0 0.139173 0 0.990268" scale="1 1 1">
    <Entity name="heading" id="17490350000000000031" active="true" position="0 5.25 0" rotation="0 0 0 1" scale="1 1 1">
     <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_heading" material_path="project/terrain_example_resources/materials/sign_heading.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
     <text_3d text="PICK AND ERASE" font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="1.1" depth="0.05" weight="0" letter_spacing="0" line_spacing="1.30" resolution="128" alignment="1" />
    </Entity>
    <Entity name="text" id="17490350000000000032" active="true" position="-5.75 4.1 0" rotation="0 0 0 1" scale="1 1 1">
     <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_text" material_path="project/terrain_example_resources/materials/sign_text.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
     <text_3d text="Ctrl-click the trail to pick its layer.&#10;Hold Shift while painting to erase.&#10;Release to refit grass and props.&#10;Undo a stroke with Ctrl+Z. Save&#10;the painted world with Ctrl+S." font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="0.55" depth="0.05" weight="0" letter_spacing="0" line_spacing="1.30" resolution="128" alignment="0" />
    </Entity>
