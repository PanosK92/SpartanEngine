   <Entity name="workshop_stamp_import" id="17490350000000000020" active="true" position="-12 6 -109" rotation="0 -0.139173 0 0.990268" scale="1 1 1">
    <Entity name="heading" id="17490350000000000021" active="true" position="0 5.25 0" rotation="0 0 0 1" scale="1 1 1">
     <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_heading" material_path="project/terrain_example_resources/materials/sign_heading.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
     <text_3d text="IMPORT A STAMP" font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="1.1" depth="0.05" weight="0" letter_spacing="0" line_spacing="1.30" resolution="128" alignment="1" />
    </Entity>
    <Entity name="text" id="17490350000000000022" active="true" position="-5.75 4.1 0" rotation="0 0 0 1" scale="1 1 1">
     <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_text" material_path="project/terrain_example_resources/materials/sign_text.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
     <text_3d text="Shape or Ground &gt; Import brush image.&#10;Open striated_rock.png in the brushes&#10;folder of terrain_example_resources.&#10;White acts, black protects. Rotate&#10;the tip and try it on the left bank." font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="0.55" depth="0.05" weight="0" letter_spacing="0" line_spacing="1.30" resolution="128" alignment="0" />
    </Entity>
