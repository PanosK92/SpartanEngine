   <Entity name="workshop_brush_tips" id="17490350000000000000" active="true" position="-8 6 -127" rotation="0 -0.104528 0 0.994522" scale="1 1 1">
    <Entity name="heading" id="17490350000000000001" active="true" position="0 5.25 0" rotation="0 0 0 1" scale="1 1 1">
     <render mesh_name="" mesh_path="" sub_mesh_index="0" material_name="sign_heading" material_path="project/terrain_example_resources/materials/sign_heading.xml" material_default="false" flags="1" max_render_distance="3.40282347e+38" max_shadow_distance="3.40282347e+38" />
     <text_3d text="BRUSH TIPS" font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="1.1" depth="0.05" weight="0" letter_spacing="0" line_spacing="1.30" resolution="128" alignment="1" />
