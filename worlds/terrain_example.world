     <text_3d text="Shape &gt; Sculpt. Pick Raise or Lower.&#10;Round builds a hill. Ring raises a rim.&#10;Rotate Ridge to line up a crest.&#10;Set Radius and Falloff. Shift reverses." font_path="data/fonts/OpenSans/OpenSans-Medium.ttf" size="0.55" depth="0.05" weight="0" letter_spacing="0" line_spacing="1.30" resolution="128" alignment="0" />
    </Entity>
